# ─── Bot / backend (apps/bot) ────────────────────────────────────────────────
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Base URL of the dashboard, used to build the /login link the bot DMs you.
# Optional; defaults to http://localhost:5173.
DASHBOARD_URL=http://localhost:5173

# ── AI provider (the bot is provider-agnostic) ───────────────────────────────
# AI_PROVIDER: "gemini" (native Google SDK) or "openai" (ANY OpenAI-compatible
#   endpoint: OpenAI, Groq, OpenRouter, DeepSeek, Together, local Ollama, ...).
AI_PROVIDER=gemini

# Model id for the chosen provider.
#   gemini : gemini-2.5-flash (default) or the cheaper gemini-2.5-flash-lite.
#            NOTE: gemini-2.0-flash is retired / has 0 free quota — don't use it.
#   openai : e.g. llama-3.3-70b-versatile (Groq), deepseek-chat,
#            gpt-4.1-nano, openai/gpt-4.1-mini (OpenRouter), etc.
AI_MODEL=gemini-2.5-flash

# API key for the chosen provider.
#   gemini : your Google AI Studio key (https://aistudio.google.com/app/apikey)
#   openai : the provider's key (Groq/OpenRouter/OpenAI/DeepSeek/...)
AI_API_KEY=your_api_key_here

# Base URL — REQUIRED only when AI_PROVIDER=openai. Examples:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   DeepSeek:   https://api.deepseek.com
#   OpenAI:     https://api.openai.com/v1
#   Ollama:     http://localhost:11434/v1
# AI_BASE_URL=

# (Back-compat: GEMINI_API_KEY / GEMINI_MODEL are still read if the AI_* ones
#  above are unset.)

# Supabase Postgres connection string.
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the "Session" pooler or direct connection; include sslmode=require.
DATABASE_URL=postgres://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres?sslmode=require

# Restrict the bot to specific Telegram user IDs (comma-separated). Every
# handler is gated on this list, so unlisted users are blocked before they
# can even /login. Leave empty to allow any linked account.
# Find your ID with @userinfobot, or check /start after linking.
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Path to Tesseract trained data (must contain ind.traineddata + eng.traineddata).
# macOS (brew):   /opt/homebrew/share/tessdata
# Linux (apt):    /usr/share/tesseract-ocr/5/tessdata  (or /usr/share/tessdata)
# Docker image:   /usr/share/tesseract-ocr/5/tessdata  (set in the Dockerfile)
TESSDATA_PREFIX=/opt/homebrew/share/tessdata

# ─── Dashboard (apps/dashboard) ──────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
# NOTE: for local dev (`pnpm dev`) these three Supabase values are supplied
# automatically by the local stack; you only need them when pointing at a
# hosted Supabase project.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_…), Settings → API Keys. Replaces the legacy
# "anon" key (anon still works but is being retired end of 2026). Browser-safe;
# access is gated by Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Your bot's username (without @), from BotFather. The login screen links to it
# so you can DM /login. No /setdomain needed (no widget).
VITE_TELEGRAM_BOT_USERNAME=kitacatat_bot
