# ─── Bot / backend (apps/bot) ────────────────────────────────────────────────
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Postgres connection string.
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the "Session" pooler or direct connection; include sslmode=require.
DATABASE_URL=postgres://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres?sslmode=require

# NOTE: there is no ALLOWED_USER_IDS anymore. Access is granted by linking a
# Telegram account to a dashboard (Supabase Auth) profile — see the dashboard's
# "Hubungkan Telegram" page.

# Path to Tesseract trained data (must contain ind.traineddata + eng.traineddata).
# macOS (brew):   /opt/homebrew/share/tessdata
# Linux (apt):    /usr/share/tesseract-ocr/5/tessdata  (or /usr/share/tessdata)
# Docker image:   /usr/share/tesseract-ocr/5/tessdata  (set in the Dockerfile)
TESSDATA_PREFIX=/opt/homebrew/share/tessdata

# ─── Dashboard (apps/dashboard) ──────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Your bot's username (without @), from BotFather. Used to build the Telegram
# deep link on the "Hubungkan Telegram" page.
VITE_TELEGRAM_BOT_USERNAME=kitacatat_bot
